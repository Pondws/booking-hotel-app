  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
