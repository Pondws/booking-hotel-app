generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AmenityScope {
  HOTEL
  ROOM
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  staffOf  HotelStaff[]
  bookings Booking[]
  reviews  Review[]
  sessions Session[]
  auditLogs AuditLog[]

  @@map("users")
}

enum SessionAudience {
  WEB
  ADMIN
}

model Session {
  id        String          @id @default(cuid())
  tokenHash String          @unique @map("token_hash")
  userId    String          @map("user_id")
  audience  SessionAudience
  expiresAt DateTime        @map("expires_at")
  userAgent String?         @map("user_agent")
  ip        String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model HotelStaff {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  hotelId   String   @map("hotel_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
  @@map("hotel_staff")
}

model Hotel {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  city        String
  address     String
  description String?
  currency    String   @default("THB")
  ratingAvg   Float    @default(0) @map("rating_avg")
  reviewCount Int      @default(0) @map("review_count")
  checkInTime  String  @default("14:00") @map("check_in_time") @db.VarChar(5)
  checkOutTime String  @default("12:00") @map("check_out_time") @db.VarChar(5)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  staff     HotelStaff[]
  images    HotelImage[]
  amenities HotelAmenity[]
  roomTypes RoomType[]
  reviews   Review[]
  auditLogs AuditLog[]

  @@index([city])
  @@map("hotels")
}

model HotelImage {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("hotel_images")
}

model Amenity {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  scope     AmenityScope
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  hotels    HotelAmenity[]
  roomTypes RoomTypeAmenity[]

  @@map("amenities")
}

model HotelAmenity {
  id        String   @id @default(cuid())
  hotelId   String   @map("hotel_id")
  amenityId String   @map("amenity_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([hotelId, amenityId])
  @@index([amenityId])
  @@map("hotel_amenities")
}

model RoomType {
  id          String   @id @default(cuid())
  hotelId     String   @map("hotel_id")
  name        String
  description String?
  capacity    Int
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  hotel       Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  images      RoomTypeImage[]
  amenities   RoomTypeAmenity[]
  rooms       Room[]
  ratePeriods RatePeriod[]

  @@index([hotelId])
  @@map("room_types")
}

model RoomTypeImage {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  url        String
  alt        String?
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId])
  @@map("room_type_images")
}

model RoomTypeAmenity {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  amenityId  String   @map("amenity_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  amenity  Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, amenityId])
  @@index([amenityId])
  @@map("room_type_amenities")
}

model Room {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  number     String
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roomType RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@unique([roomTypeId, number])
  @@map("rooms")
}

/// Raw-SQL constraints (not expressed in Prisma): rate_periods_no_overlap (EXCLUDE gist on
/// room_type_id + daterange(start_date, end_date, [)) ) and rate_periods_dates_check (end_date > start_date).
model RatePeriod {
  id         String   @id @default(cuid())
  roomTypeId String   @map("room_type_id")
  name       String?
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  price      Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)

  @@index([roomTypeId, startDate])
  @@map("rate_periods")
}

/// Raw-SQL constraints (not expressed in Prisma): bookings_no_overlap (EXCLUDE gist on room_id +
/// daterange(check_in, check_out, [)) for PENDING/CONFIRMED only), bookings_dates_check
/// (check_out > check_in) and bookings_guests_check (guests >= 1).
model Booking {
  id          String        @id @default(cuid())
  code        String        @unique
  userId      String        @map("user_id")
  roomId      String        @map("room_id")
  guestName   String        @map("guest_name")
  guestEmail  String        @map("guest_email")
  guestPhone  String?       @map("guest_phone")
  guests      Int
  checkIn     DateTime      @map("check_in") @db.Date
  checkOut    DateTime      @map("check_out") @db.Date
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @map("total_amount") @db.Decimal(10, 2)
  currency    String
  expiresAt   DateTime?     @map("expires_at")
  cancelledAt DateTime?     @map("cancelled_at")
  /// Staff-entered reason for an admin cancel (null for a customer cancel).
  cancelReason String?      @map("cancel_reason")
  /// Set at check-in; a CONFIRMED booking with this set is in house.
  checkedInAt  DateTime?    @map("checked_in_at")
  /// Set at check-out, together with status COMPLETED.
  checkedOutAt DateTime?    @map("checked_out_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict)
  payments Payment[]
  review   Review?

  @@index([userId])
  @@index([roomId, checkIn])
  @@index([status])
  @@map("bookings")
}

/// Raw-SQL constraint (not expressed in Prisma): payments_one_active_per_booking (UNIQUE booking_id
/// WHERE status IN ('PENDING', 'SUCCEEDED')) — at most one live payment attempt per booking.
model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @map("booking_id")
  amount      Decimal       @db.Decimal(10, 2)
  currency    String
  status      PaymentStatus @default(PENDING)
  provider    String
  providerRef String?       @unique @map("provider_ref")
  paidAt      DateTime?     @map("paid_at")
  refundedAt  DateTime?     @map("refunded_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("payments")
}

/// Raw-SQL constraint (not expressed in Prisma): reviews_rating_check (rating BETWEEN 1 AND 5).
model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique @map("booking_id")
  userId    String   @map("user_id")
  hotelId   String   @map("hotel_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  hotel   Hotel   @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@index([hotelId])
  @@index([userId])
  @@map("reviews")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditEntityType {
  HOTEL
  ROOM_TYPE
  ROOM
  RATE_PERIOD
  AMENITY
  STAFF
  BOOKING
}

/// One back-office write (create / update / delete). `changes` = [{ field, before, after }]: only the changed
/// fields for an UPDATE, every set field for a CREATE (before null) or DELETE (after null). `entityId` has no FK
/// so the row outlives the entity; `entityLabel` is the entity's name at the time.
model AuditLog {
  id          String          @id @default(cuid())
  actorId     String?         @map("actor_id")
  action      AuditAction
  entityType  AuditEntityType @map("entity_type")
  entityId    String          @map("entity_id")
  entityLabel String          @map("entity_label")
  /// Hotel the entity belongs to (null for amenities and staff) — STAFF see only their hotels' rows.
  hotelId     String?         @map("hotel_id")
  /// The entity whose page shows this row too: the room type for ROOM / RATE_PERIOD rows. No FK, like entityId.
  parentId    String?         @map("parent_id")
  changes     Json
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  actor User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([hotelId, createdAt])
  @@index([parentId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
