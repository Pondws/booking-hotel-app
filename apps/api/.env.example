DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_hotel?schema=public"
PORT=8000
# Comma-separated browser origins per app, used by CORS (see src/lib/cors-policy.ts):
# /api/admin/* and /api/auth/admin/* → ADMIN_ORIGINS only; /api/auth/* → WEB_ORIGINS only;
# public routes (hotels, health) → both.
WEB_ORIGINS="http://localhost:3000"
ADMIN_ORIGINS="http://localhost:3001"
# Max register/login/admin-login requests per IP per window (429 RATE_LIMITED when exceeded)
AUTH_RATE_LIMIT_MAX=10
# Rate-limit window in milliseconds (900000 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Number of reverse-proxy hops in front of the API; 0 in local dev. Never use true.
TRUST_PROXY=0
