DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_hotel?schema=public"
PORT=8000
# Comma-separated browser origins allowed by CORS (web, web-admin)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# Max register/login/admin-login requests per IP per window (429 RATE_LIMITED when exceeded)
AUTH_RATE_LIMIT_MAX=10
# Rate-limit window in milliseconds (900000 = 15 minutes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
